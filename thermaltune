#!/usr/bin/env bash
# thermaltune — calibrate the highest stable CPU cap on thermally-limited x86 laptops.
#
# Finds the maximum frequency cap where a sustained all-core load runs FLAT
# (no thermal sawtooth: no dips to the throttle floor, peak temp in bounds),
# then applies and persists it. A calibrated cap sustains MORE throughput than
# leaving the CPU uncapped, because uncapped machines oscillate between bursts
# and deep thermal throttling.
#
# Two operating modes:
#   cap        constant cap at the calibrated sweet spot (default)
#   adaptive   full speed in bursts, automatically clamped when the CPU gets
#              hot — via thermald (standard daemon) or ttc (thermaltune's
#              own temperature controller on the cap knob)
#
# Provenance: AI-authored (GLM via OpenCode), hardware-validated on a
# Surface Laptop Go 1 (i5-1035G1, CachyOS). See docs/validation.md.
# License: MIT — see LICENSE.
#
# Usage: thermaltune <command> [options]
#   calibrate            Find + apply + persist (cap or adaptive; sudo handled)
#   calibrate --defer    Schedule the run for the next boot with AC (unattended)
#   check                Verify the saved calibration still holds (~5 min)
#   status               Current state summary
#   doctor               System audit: drivers, sensors, conflicts, adaptive readiness
#   apply|on             Re-apply the saved calibration (used by systemd units)
#   off                  Temporarily remove all clamping (until next boot/resume)
#   mode [cap|adaptive]  Switch operating mode (uses saved values)
#   uninstall            Remove persistence and restore full speed
#   install-persistence  (Re)install the systemd unit(s) + resume hook
#   --selftest [dir]     Validate the analyzer against recorded calibration data
#
# Options:
#   --profile quick|thorough   Sweep depth (default: thorough)
#   --target-temp N            Peak package temp target °C (default: derived, <=85)
#   --load-seconds N           Per-step sustained load seconds (default: 210)
#   --mode cap|adaptive        Operating mode for calibrate (default: cap)
#   --engine thermald|ttc      Adaptive engine for calibrate (default: asked)
#   --defer                    Schedule calibrate for the next boot with AC power
#
# Design notes:
#   * Two-phase privilege: popups/consent run as YOUR user; only the
#     measurement core runs under sudo. No GUI ever launched as root.
#   * Calibration runs under systemd-inhibit so suspend cannot corrupt it.
#   * Only lowers ceilings — never raises voltage, power limits or clocks.
#   * Ctrl+C during calibration restores the previous cap.

set -u
umask 022

VERSION="0.2.7"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"

CONF="/etc/thermaltune.conf"
UNIT="/etc/systemd/system/thermaltune.service"
HOOK="/usr/lib/systemd/system-sleep/thermaltune-resume"
BIN="/usr/local/bin/thermaltune"
RUNS_ROOT="/var/lib/thermaltune/runs"
CAL_GUARD="/run/thermaltune-calibrating"
ANSWERS="${TMPDIR:-/tmp}/thermaltune-answers.$$.env"
THERMALD_CONF="/etc/thermald/thermal-conf.xml"
THERMALD_CONF_BAK="/etc/thermald/thermal-conf.xml.pre-thermaltune"
THERMALD_DROPIN="/etc/systemd/system/thermald.service.d/thermaltune.conf"
AUNIT="/etc/systemd/system/thermaltune-adaptive.service"
DEFER_UNIT="/etc/systemd/system/thermaltune-autocal.service"
DEFER_ANSWERS="/var/lib/thermaltune/pending-answers.env"

LOAD_S=210
SETTLE_S=75
COOL_CAP_S=150
SAMPLE_EVERY=5
CHECK_LOAD_S=240
DEFAULT_TARGET=85

PROFILE="thorough"
TARGET_TEMP=""
MODE="cap"
ENGINE=""
DEFER="0"
CAP_MODE="pct"
ORIG_MAX_FREQ=0
UI_TOOL="tty"
PKG_TEMP_FILE=""
PKG_CRIT_FILE=""

die()   { echo "thermaltune: error: $*" >&2; rm -f "$CAL_GUARD" 2>/dev/null; exit 1; }
log()   { echo "[thermaltune] $*"; }
warn()  { echo "[thermaltune] WARNING: $*" >&2; }

# ---------------------------------------------------------------- detection --

detect_platform() {
    [ "$(uname -m)" = "x86_64" ] || die "unsupported architecture: $(uname -m) (x86_64 laptops only)"
    local vendor product
    vendor="$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || echo unknown)"
    product="$(cat /sys/class/dmi/id/product_name 2>/dev/null || echo unknown)"
    case "$vendor" in
        QEMU|VMware*|innotek*|Xen|Microsoft\ Corporation\ Virtual*) : ;;
        *) : ;;
    esac
    case "$vendor $product" in
        *QEMU*|*VMware*|*VirtualBox*|*KVM*)
            die "virtual machine detected ($vendor $product) — thermaltune calibrates real hardware" ;;
    esac
    [ -d /sys/devices/system/cpu/cpu0/cpufreq ] || die "no cpufreq sysfs interface found"
    if [ -e /sys/devices/system/cpu/intel_pstate/max_perf_pct ]; then
        CAP_MODE=pct
    else
        CAP_MODE=freq
    fi
    ORIG_MAX_FREQ="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 2>/dev/null)" || die "cannot read scaling_max_freq"
}

cpu_driver() {
    if [ -e /sys/devices/system/cpu/intel_pstate/status ]; then
        echo "intel_pstate ($(cat /sys/devices/system/cpu/intel_pstate/status))"
    elif [ -e /sys/devices/system/cpu/intel_pstate ]; then
        echo "intel_pstate (passive)"
    elif ls /sys/devices/system/cpu/cpu0/cpufreq/*amd_pstate* >/dev/null 2>&1; then
        echo "amd_pstate"
    else
        echo "acpi-cpufreq"
    fi
}

find_pkg_temp() {
    local z t h f
    for z in /sys/class/thermal/thermal_zone*; do
        t="$(cat "$z/type" 2>/dev/null)" || continue
        case "$t" in
            *pkg*|*x86_pkg*) echo "$z/temp"; return 0 ;;
        esac
    done
    for h in /sys/class/hwmon/hwmon*; do
        [ "$(cat "$h/name" 2>/dev/null)" = "coretemp" ] || continue
        for f in "$h"/temp*_label; do
            [ -e "$f" ] || continue
            if grep -qi package "$f" 2>/dev/null; then echo "${f%_label}_input"; return 0; fi
        done
    done
    for h in /sys/class/hwmon/hwmon*; do
        case "$(cat "$h/name" 2>/dev/null)" in
            k10temp|zenpower) echo "$h/temp1_input"; return 0 ;;
        esac
    done
    return 1
}

find_pkg_crit() {
    local z t h f best=""
    for z in /sys/class/thermal/thermal_zone*; do
        t="$(cat "$z/type" 2>/dev/null)" || continue
        case "$t" in
            *pkg*|*x86_pkg*)
                [ -e "$z/crit" ] && { echo "$z/crit"; return 0; }
                ;;
        esac
    done
    for h in /sys/class/hwmon/hwmon*; do
        case "$(cat "$h/name" 2>/dev/null)" in
            coretemp|k10temp|zenpower)
                for f in "$h"/temp*_crit; do
                    [ -e "$f" ] || continue
                    [ -z "$best" ] && best="$f"
                done
                ;;
        esac
    done
    [ -n "$best" ] && { echo "$best"; return 0; }
    return 1
}

pkg_temp_c() {
    awk '{printf "%.1f", $1/1000}' "$PKG_TEMP_FILE" 2>/dev/null || echo "NA"
}

derive_target_temp() {
    local crit_c=100
    if [ -n "$PKG_CRIT_FILE" ] && [ -r "$PKG_CRIT_FILE" ]; then
        crit_c="$(awk '{printf "%d", $1/1000}' "$PKG_CRIT_FILE")"
    fi
    local t=$((crit_c - 15))
    [ "$t" -gt 85 ] && t=85
    [ "$t" -lt 70 ] && t=70
    echo "$t"
}

power_state() {
    local a
    for a in /sys/class/power_supply/A*; do
        [ -e "$a/online" ] || continue
        [ "$(cat "$a/online" 2>/dev/null)" = "1" ] && { echo "ac"; return 0; }
    done
    echo "battery"
}

battery_pct() {
    local b best=""
    for b in /sys/class/power_supply/BAT*; do
        [ -e "$b/capacity" ] || continue
        best="$(cat "$b/capacity" 2>/dev/null)"
        [ -n "$best" ] && break
    done
    echo "${best:--1}"
}

rapl_ok() { [ -r /sys/class/powercap/intel-rapl:0/energy_uj ]; }

# ---------------------------------------------------------------- cap I/O ----

get_cap_pct() {
    if [ "$CAP_MODE" = "pct" ]; then
        cat /sys/devices/system/cpu/intel_pstate/max_perf_pct 2>/dev/null || echo 100
    else
        local cur
        cur="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 2>/dev/null)" || { echo 100; return; }
        echo $(( (100 * cur + ORIG_MAX_FREQ / 2) / ORIG_MAX_FREQ ))
    fi
}

set_cap_pct() {
    local pct=$1 f c
    if [ "$CAP_MODE" = "pct" ]; then
        echo "$pct" > /sys/devices/system/cpu/intel_pstate/max_perf_pct 2>/dev/null || die "cannot write max_perf_pct"
    else
        f=$((ORIG_MAX_FREQ * pct / 100))
        for c in /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do
            echo "$f" > "$c" 2>/dev/null || true
        done
    fi
}

snapshot_cap() {
    # echoes restore instructions as flat lines: pct=<v> or cpuN=<freq>
    if [ "$CAP_MODE" = "pct" ]; then
        echo "pct=$(get_cap_pct)"
    else
        local c
        for c in /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do
            echo "$(basename "$(dirname "$c")")=$(cat "$c" 2>/dev/null)"
        done
    fi
}

restore_cap() {
    local line k v c
    while IFS='=' read -r k v; do
        [ -n "${k:-}" ] || continue
        if [ "$k" = "pct" ]; then
            echo "$v" > /sys/devices/system/cpu/intel_pstate/max_perf_pct 2>/dev/null || true
        else
            echo "$v" > "/sys/devices/system/cpu/$k/cpufreq/scaling_max_freq" 2>/dev/null || true
        fi
    done
}

# ---------------------------------------------------------------- UI layer ---

ui_detect() {
    if [ "$(id -u)" = "0" ] && [ -z "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
        UI_TOOL="tty"; return
    fi
    if command -v kdialog >/dev/null 2>&1; then UI_TOOL="kdialog"
    elif command -v zenity >/dev/null 2>&1; then UI_TOOL="zenity"
    else UI_TOOL="tty"; fi
}

ui_ask() { # title msg -> exit 0 = yes
    case "$UI_TOOL" in
        kdialog) kdialog --title "$1" --yesno "$2" ;;
        zenity)  zenity --question --title="$1" --text="$2" --width=520 ;;
        *)       local a; printf '%s\n%s\n[y/N] ' "$1" "$2" >&2; read -r a; [ "$a" = "y" ] || [ "$a" = "Y" ] ;;
    esac
}

ui_info() { # title msg
    case "$UI_TOOL" in
        kdialog) kdialog --title "$1" --msgbox "$2" ;;
        zenity)  zenity --info --title="$1" --text="$2" --width=520 ;;
        *)       printf '%s\n%s\n' "$1" "$2" >&2 ;;
    esac
}

# ask which adaptive engine to use; echoes thermald|ttc or fails
choose_engine() {
    local msg="Adaptive mode needs a temperature controller. Two engines:

  thermald — the standard Linux thermal daemon. thermaltune writes
      its config and verifies it actually clamps (some laptops lack
      what thermald needs).
  ttc — thermaltune's own controller, driving the same proven
      frequency-cap knob up and down. Works wherever cap mode works."
    local choice=""
    case "$UI_TOOL" in
        kdialog)
            choice="$(kdialog --title 'thermaltune — engine' --radiolist "$msg" \
                thermald 'thermald (standard daemon)' off \
                ttc 'ttc (thermaltune controller)' off 2>/dev/null)"
            ;;
        zenity)
            choice="$(zenity --list --radiolist --title='thermaltune — engine' --text="$msg" \
                --column='' --column='Engine' --column='Description' \
                TRUE thermald 'standard thermal daemon' \
                FALSE ttc 'thermaltune own controller' --width=560 --height=340 2>/dev/null)"
            ;;
        *)
            printf '%s\n\n  1) thermald — standard Linux thermal daemon\n  2) ttc — thermaltune own controller (always works with the cap knob)\n[1/2] ' "$msg" >&2
            read -r choice
            ;;
    esac
    case "$choice" in
        thermald*|1) echo thermald ;;
        ttc*|2) echo ttc ;;
        *) return 1 ;;
    esac
}

detect_heavy_apps() {
    ps -eo pcpu,comm --sort=-pcpu 2>/dev/null \
        | awk 'NR>1 && $1+0>=15 && $2 !~ /^(ps|thermaltune|stress-ng|sudo|bash)$/ {print $2}' \
        | sort -u | head -5
}

est_minutes() { # $1 = n_steps -> typical minutes
    local n=${1:-8}
    echo $(( n * (LOAD_S + SETTLE_S + 30) / 60 ))
}
est_minutes_worst() {
    local n=${1:-12}
    echo $(( n * (LOAD_S + SETTLE_S + COOL_CAP_S + 15) / 60 ))
}

# ------------------------------------------------------------- measurement ---

avg_freq() { awk '{s+=$1;n++} END{if(n>0) printf "%.0f", s/n/1000; else print 0}' /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq 2>/dev/null; }
min_freq() { awk 'BEGIN{m=0} {if(m==0||$1<m)m=$1} END{if(m>0) printf "%.0f", m/1000}' /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq 2>/dev/null; }

start_sampler() { # $1 csv path ; sets SAMPLER_PID
    local csv=$1
    (
        while :; do
            if [ "${RAPL_AVAILABLE:-0}" = "1" ]; then
                printf '%s,%s,%s,%s,%s\n' "$SECONDS" "$(pkg_temp_c)" "$(avg_freq)" "$(min_freq)" "$(cat /sys/class/powercap/intel-rapl:0/energy_uj 2>/dev/null)" >> "$csv"
            else
                printf '%s,%s,%s,%s\n' "$SECONDS" "$(pkg_temp_c)" "$(avg_freq)" "$(min_freq)" >> "$csv"
            fi
            sleep "$SAMPLE_EVERY"
        done
    ) &
    SAMPLER_PID=$!
}

stop_sampler() {
    [ -n "${SAMPLER_PID:-}" ] || return 0
    kill "$SAMPLER_PID" 2>/dev/null || true
    wait "$SAMPLER_PID" 2>/dev/null || true
    SAMPLER_PID=""
}

# analyze_csv FILE CAPF TARGET  -> emits KEY=VALUE env on stdout
# stable criterion: floor-dips <= 5% of samples, sustained clock >= 90% of cap,
# peak temp <= target. CSV: t,temp_c,avg_freq_mhz,min_freq_mhz[,energy_uj]
analyze_csv() {
    local file=$1 capf=$2 tgt=$3
    local rows sk maxe="0"
    rows="$(wc -l < "$file" 2>/dev/null)" || rows=0
    if [ "${rows:-0}" -lt 6 ]; then
        echo "STABLE=0 EMPTY=1"
        return 0
    fi
    sk=$(( rows * 2 / 5 )); [ "$sk" -lt 2 ] && sk=2
    [ -r /sys/class/powercap/intel-rapl:0/max_energy_range_uj ] && maxe="$(cat /sys/class/powercap/intel-rapl:0/max_energy_range_uj)"
    awk -F, -v cap="$capf" -v tgt="$tgt" -v sk="$sk" -v maxe="$maxe" '
        NR > sk {
            n++; ts += $2; tf += $3; tm += $4; if ($2 > mt) mt = $2;
            if ($3 < cap * 0.5) dips++;
            if (NF >= 5 && prv != "") {
                e = $5; if (e < prv) e += maxe + 1;
                es += e - prv; dt += $1 - prvt;
            }
            prv = $5; prvt = $1;
        }
        END {
            if (n == 0) { printf "STABLE=0 EMPTY=1\n"; exit }
            dfrac = dips * 100.0 / n;
            ratio = int(100 * tf / n / cap);
            pwr = "NA";
            if (dt > 0) pwr = sprintf("%.1f", es / 1000000 / dt);
            st = (dfrac <= 5 && ratio >= 90 && mt <= tgt) ? 1 : 0;
            printf "STABLE=%d N=%d STEADY_T=%.1f PEAK_T=%.1f STEADY_F=%.0f MIN_F=%.0f DIPS_FRAC=%.1f RATIO=%d PWR_W=%s\n", st, n, ts/n, mt, tf/n, tm/n, dfrac, ratio, pwr;
        }
    ' "$file"
}

# shellcheck disable=SC2120
parse_ops_per_s() { # stress.log -> ops/s or NA
    local line
    line="$(awk '$4=="cpu"{print; exit}' "$1" 2>/dev/null)"
    [ -n "$line" ] || { echo "NA"; return 0; }
    eval "$(echo "${line#*cpu}" | awk '{n=0; for(i=1;i<=NF;i++){x=$i; gsub(/[^0-9.]/,"",x); if(x!="" && x+0==x){v[++n]=x}} if(n>=2) printf "OPS=%s REAL=%s", v[1], v[2]}')"
    if [ -n "${OPS:-}" ] && [ -n "${REAL:-}" ]; then
        awk -v o="$OPS" -v r="$REAL" 'BEGIN{ if (r+0 > 0) printf "%.0f", o/r; else print "NA" }'
    else
        echo "NA"
    fi
}

parse_tstat() { # tstat file capf -> real avg MHz or NA
    [ -s "$1" ] || { echo "NA"; return 0; }
    tail -n 10 "$1" 2>/dev/null | awk -v hi="$(($2 + 100))" '
        { gsub(/[^0-9 ]/," ",$0); n=split($0,a," ");
          for(i=1;i<=n;i++) if(a[i]>=200 && a[i]<=hi){s+=a[i];c++} }
        END{ if(c>0) printf "%.0f", s/c; else print "NA" }'
}

getkey() { # file key -> value or empty
    awk -F= -v k="$2" '$1==k{print $2; exit}' "$1" 2>/dev/null
}

cool_wait() { # target C
    local i t
    for i in $(seq 1 $(( COOL_CAP_S / 5 ))); do
        t="$(pkg_temp_c)"
        if awk -v t="$t" -v c="$1" 'BEGIN{exit !(t+0 <= c+0)}'; then return 0; fi
        sleep 5
    done
}

# run_step LABEL PCT OUTDIR  -> writes $OUTDIR/$LABEL.env ; human summary to stdout
run_step() {
    local label=$1 pct=$2 out=$3
    local capf csv ts idle_t real_clk ops
    set_cap_pct "$pct"
    # cap reference in MHz to match the sampler's frequency units
    if [ "$CAP_MODE" = "pct" ]; then
        capf=$(( ORIG_MAX_FREQ * pct / 100 / 1000 ))
    else
        capf=$(( $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq) / 1000 ))
    fi
    if [ -n "${IDLE_REF:-}" ]; then
        cool_wait "$IDLE_REF"
    fi
    sleep "$SETTLE_S"
    idle_t="$(pkg_temp_c)"
    : "${IDLE_REF:=$idle_t}"

    csv="$out/$label.csv"; ts="$out/$label.tstat"
    rm -f "$csv" "$ts" "$out/$label.stress.log"
    start_sampler "$csv"

    echo "[load] $label — cap ${pct}% (~$capf MHz), full all-core load for ${LOAD_S}s ..."
    stress-ng --cpu "$(nproc)" --cpu-method matrixprod --timeout "${LOAD_S}s" --metrics-brief > "$out/$label.stress.log" 2>&1 &
    local lpid=$!
    if command -v turbostat >/dev/null 2>&1; then
        sleep $(( LOAD_S - 25 ))
        timeout 25 turbostat --quiet --interval 5 --num_iterations 3 --show Bzy_MHz --out "$ts" >/dev/null 2>&1
    fi
    wait "$lpid"
    stop_sampler

    eval "$(analyze_csv "$csv" "$capf" "${TARGET_TEMP:-85}")"
    real_clk="$(parse_tstat "$ts" "$capf")"
    ops="$(parse_ops_per_s "$out/$label.stress.log")"

    {
        echo "label=$label"
        echo "pct=$pct"
        echo "cap_mhz=$capf"
        echo "idle_temp_c=$idle_t"
        echo "steady_temp_c=${STEADY_T:-NA}"
        echo "peak_temp_c=${PEAK_T:-NA}"
        echo "steady_clock_mhz=${STEADY_F:-NA}"
        echo "dips_frac=${DIPS_FRAC:-NA}"
        echo "clock_ratio_pct=${RATIO:-NA}"
        echo "power_w=${PWR_W:-NA}"
        echo "real_clock_mhz=$real_clk"
        echo "ops_per_s=$ops"
        echo "stable=${STABLE:-0}"
    } > "$out/$label.env"

    if [ "${EMPTY:-0}" = "1" ]; then
        echo "[step] $label — FAILED to sample (no data)"
    else
        echo "[step] $label — cap ${pct}%: steady ${STEADY_F} MHz (${RATIO}% of cap), peak ${PEAK_T}C, dips ${DIPS_FRAC}%, ${ops} ops/s -> $( [ "${STABLE:-0}" = 1 ] && echo STABLE || echo UNSTABLE )"
    fi
}

# ------------------------------------------------------------ persistence ---

do_install_persistence() {
    [ "$(id -u)" = 0 ] || die "install-persistence needs root"
    install -Dm755 "$SELF" "$BIN"
    cat > "$UNIT" <<UNIT
[Unit]
Description=Apply thermaltune calibrated CPU cap
After=multi-user.target

[Service]
Type=oneshot
ExecStart=$BIN apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
UNIT
    cat > "$HOOK" <<HOOK
#!/bin/bash
# thermaltune resume hook — re-apply the calibrated cap after suspend
# (skipped while a calibration is running: /run/thermaltune-calibrating)
if [ "\$1" = post ] && [ ! -e /run/thermaltune-calibrating ]; then
    $BIN apply >/dev/null 2>&1 || true
fi
HOOK
    chmod 755 "$HOOK"
    cat > "$AUNIT" <<AUNIT
[Unit]
Description=thermaltune adaptive temperature controller (ttc engine)
After=multi-user.target

[Service]
Type=simple
ExecStart=$BIN --_internal adaptive-loop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
AUNIT
    systemctl daemon-reload
    systemctl enable thermaltune.service >/dev/null 2>&1
    if [ "${ENGINE:-}" = "ttc" ]; then
        systemctl enable thermaltune-adaptive.service >/dev/null 2>&1 || true
    fi
    # a running adaptive controller keeps the old code until restarted —
    # so a reinstall always bounces an active service (skipped mid-calibration)
    if [ ! -e /run/thermaltune-calibrating ] && systemctl is-active --quiet thermaltune-adaptive.service 2>/dev/null; then
        systemctl restart thermaltune-adaptive.service
        log "adaptive service restarted (updated controller active)"
    fi
    log "persistence installed: unit + resume hook enabled (script at $BIN)"
}

cmd_install_persistence() {
    do_install_persistence
}

cmd_internal_defer_calibration() { # install a one-shot boot-time calibration unit (root)
    [ "$(id -u)" = 0 ] || die "internal phase must run as root"
    [ -n "$TARGET_TEMP" ] || TARGET_TEMP="$(derive_target_temp)"
    install -Dm755 "$SELF" "$BIN"
    mkdir -p "$(dirname "$DEFER_ANSWERS")"
    cat > "$DEFER_UNIT" <<UNIT
[Unit]
Description=thermaltune deferred calibration (runs once at next boot with AC power)
After=multi-user.target thermaltune.service
ConditionACPower=yes

[Service]
Type=oneshot
TimeoutStartSec=2h
ExecStartPre=/bin/sh -c 'printf "PROFILE=%s\\nTARGET_TEMP=%s\\nMODE=cap\\nENGINE=\\n" "$PROFILE" "$TARGET_TEMP" > $DEFER_ANSWERS'
ExecStart=/usr/bin/systemd-inhibit --what=sleep:idle $BIN --_internal calibrate $DEFER_ANSWERS
ExecStartPost=/bin/rm -f $DEFER_ANSWERS
ExecStartPost=/usr/bin/systemctl disable thermaltune-autocal.service

[Install]
WantedBy=multi-user.target
UNIT
    systemctl daemon-reload
    systemctl enable thermaltune-autocal.service >/dev/null 2>&1 || true
    log "deferred calibration scheduled: runs once at the next boot with AC power (profile: $PROFILE, target: ${TARGET_TEMP}C)"
    log "watch progress: journalctl -u thermaltune-autocal -f"
    log "cancel: sudo systemctl disable thermaltune-autocal.service"
}

cmd_uninstall() {
    [ "$(id -u)" = 0 ] || exec sudo -p "[thermaltune] password: " bash "$SELF" uninstall
    systemctl disable --now thermaltune.service 2>/dev/null || true
    systemctl disable --now thermaltune-adaptive.service 2>/dev/null || true
    rm -f "$UNIT" "$AUNIT" "$HOOK" "$CONF" "$BIN"
    rm -f "$THERMALD_DROPIN"
    if [ -f "$THERMALD_CONF_BAK" ]; then
        cp -a "$THERMALD_CONF_BAK" "$THERMALD_CONF"
        rm -f "$THERMALD_CONF_BAK"
        log "restored previous thermald configuration"
    else
        rm -f "$THERMALD_CONF"
    fi
    systemctl try-restart thermald.service 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
    set_cap_pct 100
    log "uninstalled: units, resume hook, config and $BIN removed; cap restored to 100%"
    log "note: the thermald package (if installed) was left in place — remove with 'pacman -R thermald' if unwanted"
    log "(the repository copy at $(dirname "$SELF") was left untouched)"
}

# ---------------------------------------------------------------- commands ---

cmd_apply() {
    [ "$(id -u)" = 0 ] || exec sudo -p "[thermaltune] password: " bash "$SELF" apply
    [ -f "$CONF" ] || die "no calibration saved yet — run: thermaltune calibrate"
    local mode pct engine
    mode="$(getkey "$CONF" MODE)"; [ -n "$mode" ] || mode=cap
    pct="$(getkey "$CONF" CAP_PCT)"
    [ -n "$pct" ] || die "corrupt config: $CONF"
    set_cap_pct "$pct"
    if [ "$mode" = "adaptive" ]; then
        engine="$(getkey "$CONF" ADAPT_ENGINE)"
        if [ "$engine" = "ttc" ]; then
            systemctl enable --now thermaltune-adaptive.service >/dev/null 2>&1 || true
            echo "adaptive applied: controller service active, ceiling ${pct}%"
        else
            systemctl enable --now thermald.service >/dev/null 2>&1 || true
            systemctl restart thermald.service 2>/dev/null || true
            echo "adaptive applied: thermald active with thermaltune target, ceiling ${pct}%"
        fi
    else
        echo "cap applied: max ${pct}%"
    fi
}

cmd_off() {
    [ "$(id -u)" = 0 ] || exec sudo -p "[thermaltune] password: " bash "$SELF" off
    if [ "$(getkey "$CONF" MODE 2>/dev/null)" = "adaptive" ]; then
        systemctl stop thermaltune-adaptive.service 2>/dev/null || true
        systemctl stop thermald.service 2>/dev/null || true
        echo "adaptive clamping off: full turbo (temporary — re-applied at next boot or resume)"
    else
        echo "cap removed: full turbo (temporary — re-applied at next boot or resume)"
    fi
    set_cap_pct 100
}

cmd_mode() { # [cap|adaptive] — switch operating mode using saved calibration
    # validate before elevating: a typo must not cost a sudo password
    if [ -n "${1:-}" ] && [ "$1" != "cap" ] && [ "$1" != "adaptive" ]; then
        die "unknown mode: $1 (cap|adaptive)"
    fi
    [ "$(id -u)" = 0 ] || exec sudo -p "[thermaltune] password: " bash "$SELF" mode "$@"
    [ -f "$CONF" ] || die "no calibration saved yet — run: thermaltune calibrate"
    local want cur engine target
    cur="$(getkey "$CONF" MODE)"; [ -n "$cur" ] || cur=cap
    want="${1:-}"
    if [ -z "$want" ]; then
        [ "$cur" = "cap" ] && want=adaptive || want=cap
    fi
    [ "$want" = "cap" ] || [ "$want" = "adaptive" ] || die "unknown mode: $want (cap|adaptive)"
    if [ "$want" = "$cur" ]; then
        echo "already in $want mode"
        return 0
    fi
    if [ "$want" = "adaptive" ]; then
        engine="$(getkey "$CONF" ADAPT_ENGINE)"
        target="$(getkey "$CONF" ADAPT_TARGET)"
        [ -n "$target" ] || target="$(getkey "$CONF" TARGET_TEMP)"
        [ -n "$target" ] || die "no temperature target in $CONF — calibrate first"
        if [ -z "$engine" ]; then
            [ "$CAP_MODE" = "pct" ] || die "no adaptive engine for this driver — calibrate with: thermaltune calibrate --mode adaptive"
            engine=ttc
            log "no engine recorded (cap-mode calibration) — using ttc on the same cap knob"
        fi
        set_cap_pct 100
        set_conf_key MODE adaptive
        set_conf_key ADAPT_ENGINE "$engine"
        set_conf_key ADAPT_TARGET "$target"
        if [ "$engine" = "ttc" ]; then
            do_install_persistence
            systemctl enable --now thermaltune-adaptive.service >/dev/null 2>&1 || true
            systemctl is-active thermaltune-adaptive.service >/dev/null 2>&1 \
                || die "adaptive service failed to start — see: journalctl -u thermaltune-adaptive"
            echo "adaptive mode active (engine: ttc, target ${target} C)"
        else
            local cdev
            cdev="$(find_thermal_cdev 2>/dev/null || true)"
            [ -n "$cdev" ] || die "no cooling device for the thermald engine — run: thermaltune calibrate --mode adaptive --engine ttc"
            backup_thermald_conf
            write_thermald_conf "$target" "$cdev"
            systemctl enable --now thermald.service >/dev/null 2>&1 || true
            systemctl restart thermald.service 2>/dev/null || true
            echo "adaptive mode active (engine: thermald, target ${target} C)"
        fi
        log "note: 'mode' reuses the saved target without re-verification — for a verified target run: thermaltune calibrate --mode adaptive"
    else
        disable_adaptive_engines
        set_conf_key MODE cap
        local pct
        pct="$(getkey "$CONF" CAP_PCT)"; [ -n "$pct" ] || pct=100
        set_cap_pct "$pct"
        echo "cap mode active: max ${pct}%"
        log "note: thermald may still be running with its default configuration — 'systemctl disable --now thermald' if unwanted"
    fi
}

cmd_status() {
    local driver cur conf_pct="" peak="" date="" pstate="" cmode="" cengine="" ctarget=""
    driver="$(cpu_driver)"
    cur="$(get_cap_pct)"
    echo "thermaltune $VERSION — status"
    echo "  driver:          $driver (cap mode: $CAP_MODE)"
    echo "  current cap:     ${cur}% (~$(( ORIG_MAX_FREQ * cur / 100 / 1000 )) MHz)"
    if [ -f "$CONF" ]; then
        conf_pct="$(getkey "$CONF" CAP_PCT)"
        peak="$(getkey "$CONF" CALIBRATED_PEAK_C)"
        date="$(getkey "$CONF" CALIBRATED_DATE)"
        pstate="$(getkey "$CONF" POWER_STATE)"
        cmode="$(getkey "$CONF" MODE)"; [ -n "$cmode" ] || cmode=cap
        echo "  mode:            $cmode"
        if [ "$cmode" = "adaptive" ]; then
            cengine="$(getkey "$CONF" ADAPT_ENGINE)"
            ctarget="$(getkey "$CONF" ADAPT_TARGET)"
            if [ "$cengine" = "ttc" ]; then
                echo "  controller:      thermaltune-adaptive.service $(systemctl is-active thermaltune-adaptive.service 2>/dev/null || echo inactive)"
            else
                echo "  controller:      thermald.service $(systemctl is-active thermald.service 2>/dev/null || echo inactive)"
            fi
            echo "  target:          peak <= ${ctarget:-?} C"
        fi
        echo "  saved cap:       ${conf_pct}%  (calibrated $date, peak ${peak}C, on $pstate)"
    else
        echo "  saved cap:       none (run: thermaltune calibrate)"
    fi
    local ustate
    ustate="$(systemctl is-enabled thermaltune.service 2>/dev/null || true)"
    [ -z "$ustate" ] && ustate="not-installed"
    echo "  persistence:     unit $ustate, hook $([ -e "$HOOK" ] && echo present || echo absent)"
    if [ -n "$PKG_TEMP_FILE" ]; then
        echo "  package temp:    $(pkg_temp_c) C   clock now: $(avg_freq) MHz"
    fi
    if [ -n "$pstate" ] && [ "$pstate" != "$(power_state)" ]; then
        warn "calibrated on $pstate but currently on $(power_state) — the flat point may differ"
    fi
}

cmd_doctor() {
    local driver cur crit_c target dep
    echo "thermaltune $VERSION — doctor"
    echo "== platform"
    echo "  machine:  $(cat /sys/class/dmi/id/sys_vendor 2>/dev/null) $(cat /sys/class/dmi/id/product_name 2>/dev/null)"
    echo "  kernel:   $(uname -r)  ($(uname -m))"
    echo "  cpu:      $(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | xargs || echo '?')"
    echo "  driver:   $(cpu_driver)"
    if [ "$CAP_MODE" = "pct" ]; then
        echo "  cap knob: intel_pstate max_perf_pct [supported]"
    else
        echo "  cap knob: per-cpu scaling_max_freq [supported, less elegant]"
    fi
    echo "== thermals"
    if [ -n "$PKG_TEMP_FILE" ]; then
        local tsrc
        tsrc="$(basename "$(dirname "$PKG_TEMP_FILE")")"
        if [ -e "$(dirname "$PKG_TEMP_FILE")/type" ]; then
            tsrc="$(cat "$(dirname "$PKG_TEMP_FILE")/type")"
        fi
        echo "  package temp now: $(pkg_temp_c) C  ($tsrc)"
    else
        echo "  [fail] no CPU package temperature sensor found"
    fi
    if [ -n "$PKG_CRIT_FILE" ] && [ -r "$PKG_CRIT_FILE" ]; then
        crit_c="$(awk '{printf "%d", $1/1000}' "$PKG_CRIT_FILE")"
    else
        crit_c=100
    fi
    target="$(derive_target_temp)"
    echo "  hardware crit:    ${crit_c} C -> default target ${target} C"
    echo "== adaptive mode readiness"
    local acdev
    rapl_ok && RAPL_AVAILABLE=1
    acdev="$(find_thermal_cdev 2>/dev/null || true)"
    if [ -n "$acdev" ]; then
        echo "  [ok] thermald engine possible (control device: $acdev)"
        if [ "$acdev" != "rapl_controller" ] && ! rapl_ok; then
            echo "       (as root, thermald may prefer its built-in rapl_controller instead)"
        fi
    else
        echo "  [warn] no cooling device thermald can drive — thermald engine cannot engage; use engine ttc"
    fi
    if command -v thermald >/dev/null 2>&1 || { command -v pacman >/dev/null 2>&1 && pacman -Q thermald >/dev/null 2>&1; }; then
        echo "  [ok] thermald available"
    else
        echo "  [info] thermald not installed (adaptive calibrate installs it with your consent)"
    fi
    if [ "$CAP_MODE" = "pct" ]; then
        echo "  [ok] ttc engine possible (intel_pstate max_perf_pct)"
    else
        echo "  [warn] ttc engine unavailable (needs intel_pstate active mode)"
    fi
    echo "== frequency policy"
    cur="$(get_cap_pct)"
    echo "  current cap: ${cur}%   governor: $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)"
    echo "  EPP: $(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null || echo n/a)"
    if [ -e /sys/devices/system/cpu/intel_pstate/no_turbo ]; then
        echo "  turbo disabled: $(cat /sys/devices/system/cpu/intel_pstate/no_turbo)"
    fi
    echo "== daemons that may fight the cap"
    local d name bad=0 conf_mode
    conf_mode="$(getkey "$CONF" MODE 2>/dev/null || true)"
    for d in tlp thermald auto-cpufreq cpupower; do
        if systemctl is-enabled "$d.service" >/dev/null 2>&1 || pgrep -x "$d" >/dev/null 2>&1; then
            if [ "$d" = "thermald" ] && [ "$conf_mode" = "adaptive" ]; then
                echo "  [ok] thermald active (it is the configured adaptive engine)"
            else
                echo "  [warn] $d is active — it may rewrite frequency policy and override the cap"
                bad=1
            fi
        fi
    done
    if systemctl is-active power-profiles-daemon.service >/dev/null 2>&1 || systemctl is-enabled power-profiles-daemon.service >/dev/null 2>&1; then
        echo "  [ok] power-profiles-daemon active (normal; does not touch max_perf_pct)"
    fi
    [ "$bad" = 1 ] && echo "  note: thermaltune does not disable these; see README (conflicts section)"
    echo "== dependencies"
    for dep in stress-ng turbostat kdialog zenity; do
        command -v "$dep" >/dev/null 2>&1 && echo "  [ok] $dep" || echo "  [missing] $dep"
    done
    rapl_ok && echo "  [ok] RAPL power meter readable" || echo "  [warn] RAPL power meter not readable without root (power reporting disabled for non-root runs)"
    echo "== persistence"
    systemctl is-enabled thermaltune.service >/dev/null 2>&1 \
        && echo "  [ok] unit enabled" || echo "  [info] unit not installed (installed automatically by calibrate)"
    [ -f "$CONF" ] && echo "  [ok] saved calibration exists ($(getkey "$CONF" CALIBRATED_DATE))" \
                   || echo "  [info] no calibration yet"
    echo "== sensors inventory"
    for h in /sys/class/hwmon/hwmon*; do
        echo "  $(cat "$h/name" 2>/dev/null): $(ls "$h" 2>/dev/null | grep -c 'temp.*_input') temp inputs"
    done
}

cmd_check() {
    [ -f "$CONF" ] || die "no calibration saved yet — run: thermaltune calibrate"
    if [ "$(getkey "$CONF" MODE 2>/dev/null)" = "adaptive" ]; then
        cmd_check_adaptive
        return
    fi
    local saved_pct saved_peak cal_date cur
    saved_pct="$(getkey "$CONF" CAP_PCT)"
    saved_peak="$(getkey "$CONF" CALIBRATED_PEAK_C)"
    cal_date="$(getkey "$CONF" CALIBRATED_DATE)"
    cur="$(get_cap_pct)"
    if [ "$cur" != "$saved_pct" ]; then
        if [ "$(id -u)" = 0 ]; then
            log "current cap ($cur%) differs from saved ($saved_pct%) — applying saved cap for the check"
            set_cap_pct "$saved_pct"
        else
            warn "cap currently differs from saved (ran 'off'?) — checking the CURRENT cap; use sudo for the saved one"
        fi
    fi
    log "check: ${CHECK_LOAD_S}s full all-core load at current settings (calibrated $cal_date, baseline peak ${saved_peak}C)"
    log "do not use the machine during the check."
    local out="/tmp/thermaltune-check.$$"
    mkdir -p "$out"
    if [ "$(id -u)" = 0 ]; then out="$RUNS_ROOT/checks"; mkdir -p "$out"; fi
    local csv="$out/check.csv"
    rm -f "$csv"
    if rapl_ok; then RAPL_AVAILABLE=1; fi
    sleep 30
    start_sampler "$csv"
    stress-ng --cpu "$(nproc)" --cpu-method matrixprod --timeout "${CHECK_LOAD_S}s" --metrics-brief > "$out/check.stress.log" 2>&1 &
    local lpid=$!
    wait "$lpid"
    stop_sampler
    local capf
    if [ "$CAP_MODE" = "pct" ]; then capf=$(( ORIG_MAX_FREQ * $(get_cap_pct) / 100 / 1000 )); else capf=$(( $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq) / 1000 )); fi
    eval "$(analyze_csv "$csv" "$capf" "$(( saved_peak + 6 ))")"
    local verdict="PASS"
    [ "${STABLE:-0}" = "1" ] || verdict="FAIL"
    echo "check result: $verdict"
    echo "  peak temp:   ${PEAK_T} C (baseline +6 margin)"
    echo "  floor dips:  ${DIPS_FRAC:-NA}% (limit 5%)"
    echo "  clock:       ${STEADY_F:-NA} MHz (${RATIO:-NA}% of cap)"
    if [ "$verdict" = "PASS" ]; then
        log "saved cap is still valid for current conditions"
    else
        log "conditions changed (season, dust, cooling) — re-run: thermaltune calibrate"
    fi
    rm -rf "$out"
    [ "$verdict" = "PASS" ]
}

cmd_check_adaptive() { # verify the live engine holds within target (engine stays active)
    local target engine
    target="$(getkey "$CONF" ADAPT_TARGET)"; [ -n "$target" ] || target=85
    engine="$(getkey "$CONF" ADAPT_ENGINE)"; [ -n "$engine" ] || engine=ttc
    if [ "$engine" = "ttc" ] && ! systemctl is-active thermaltune-adaptive.service >/dev/null 2>&1; then
        die "adaptive service is not running — run: thermaltune apply"
    fi
    if [ "$engine" = "thermald" ] && ! systemctl is-active thermald.service >/dev/null 2>&1; then
        die "thermald is not running — run: thermaltune apply"
    fi
    log "adaptive check: ${CHECK_LOAD_S}s full all-core load — the $engine engine is LIVE during the check"
    log "do not use the machine during the check."
    local out
    if [ "$(id -u)" = 0 ]; then out="$RUNS_ROOT/checks"; else out="/tmp/thermaltune-check.$$"; fi
    mkdir -p "$out"
    local csv="$out/check.csv"
    rm -f "$csv"
    if [ "$(id -u)" = 0 ] && rapl_ok; then RAPL_AVAILABLE=1; fi
    sleep 30
    start_sampler "$csv"
    stress-ng --cpu "$(nproc)" --cpu-method matrixprod --timeout "${CHECK_LOAD_S}s" --metrics-brief > "$out/check.stress.log" 2>&1 &
    local lpid=$!
    wait "$lpid"
    stop_sampler
    eval "$(analyze_csv "$csv" "$(( ORIG_MAX_FREQ / 1000 ))" "$target")"
    local verdict="PASS"
    if [ "${PEAK_T:-NA}" = "NA" ]; then
        verdict="FAIL"
    elif awk -v p="$PEAK_T" -v t="$target" 'BEGIN{exit !(p+0 > t+6)}'; then
        verdict="FAIL"
    fi
    echo "adaptive check result: $verdict"
    echo "  peak temp:   ${PEAK_T:-NA} C (target ${target} C, fail margin +6)"
    echo "  steady temp: ${STEADY_T:-NA} C"
    echo "  avg clock:   ${STEADY_F:-NA} MHz (engine modulates; dips are normal here)"
    if [ "$verdict" = "PASS" ]; then
        log "engine is holding within target"
    else
        log "engine overshoots the target — recalibrate: thermaltune calibrate --mode adaptive"
    fi
    rm -rf "$out"
    [ "$verdict" = "PASS" ]
}

# --------------------------------------------------------------- calibrate ---

write_conf() { # mode pct target pstate peak clock ops adapt_target adapt_engine
    {
        echo "# thermaltune state — written by calibrate"
        echo "MODE=$1"
        echo "CAP_PCT=$2"
        echo "TARGET_TEMP=$3"
        echo "POWER_STATE=$4"
        echo "CALIBRATED_DATE=$(date +%Y-%m-%dT%H:%M:%S)"
        echo "CALIBRATED_PEAK_C=$5"
        echo "CALIBRATED_CLOCK_MHZ=$6"
        echo "CALIBRATED_OPS_S=$7"
        echo "ADAPT_TARGET=$8"
        echo "ADAPT_ENGINE=$9"
        echo "VERSION=$VERSION"
    } > "$CONF"
    chmod 644 "$CONF"
}

set_conf_key() { # KEY VALUE — edit one key in CONF in place
    if grep -q "^$1=" "$CONF" 2>/dev/null; then
        sed -i "s|^$1=.*|$1=$2|" "$CONF"
    else
        printf '%s=%s\n' "$1" "$2" >> "$CONF"
    fi
}

cmd_calibrate() {
    # per-command flags (so "thermaltune calibrate --defer" works naturally)
    while [ $# -gt 0 ]; do
        case "$1" in
            --profile) [ $# -ge 2 ] || die "option $1 needs a value (see --help)"; PROFILE="$2"; shift 2 ;;
            --target-temp) [ $# -ge 2 ] || die "option $1 needs a value (see --help)"; TARGET_TEMP="$2"; shift 2 ;;
            --load-seconds) [ $# -ge 2 ] || die "option $1 needs a value (see --help)"; LOAD_S="$2"; shift 2 ;;
            --mode) [ $# -ge 2 ] || die "option $1 needs a value (see --help)"; MODE="$2"; shift 2 ;;
            --engine) [ $# -ge 2 ] || die "option $1 needs a value (see --help)"; ENGINE="$2"; shift 2 ;;
            --defer) DEFER="1"; shift ;;
            *) die "unknown calibrate option: $1 (see --help)" ;;
        esac
    done
    # ---- flag validation (fail fast, before any popup or elevation) ----
    case "$PROFILE" in quick|thorough) ;; *) die "unknown profile: '$PROFILE' (use --profile quick|thorough)" ;; esac
    case "$MODE" in cap|adaptive) ;; *) die "unknown mode: '$MODE' (use --mode cap|adaptive)" ;; esac
    case "$ENGINE" in ""|thermald|ttc) ;; *) die "unknown engine: '$ENGINE' (use --engine thermald|ttc)" ;; esac
    awk -v l="$LOAD_S" 'BEGIN{ exit !(l ~ /^[0-9]+$/ && l >= 30 && l <= 600) }' \
        || die "invalid --load-seconds: '$LOAD_S' (integer seconds, 30-600)"
    [ -n "$TARGET_TEMP" ] || TARGET_TEMP="$(derive_target_temp)"
    awk -v t="$TARGET_TEMP" 'BEGIN{ exit !(t ~ /^[0-9]+$/ && t >= 40 && t <= 95) }' \
        || die "invalid --target-temp: '$TARGET_TEMP' (integer Celsius, 40-95)"
    # ---- user phase: consent, deps, preflight ----
    detect_platform
    PKG_TEMP_FILE="$(find_pkg_temp)" || die "no CPU package temperature sensor found"
    PKG_CRIT_FILE="$(find_pkg_crit || true)"
    ui_detect
    if [ "$(id -u)" = "0" ]; then
        log "running as root — popups disabled, terminal prompts only (recommended: run WITHOUT sudo; sudo is used internally)"
        UI_TOOL="tty"
    fi

    # ---- mode / engine validation ----
    if [ "$MODE" != "cap" ] && [ "$MODE" != "adaptive" ]; then
        die "unknown mode: $MODE (use --mode cap|adaptive)"
    fi
    if [ "$MODE" = "adaptive" ] && [ -z "$ENGINE" ]; then
        ENGINE="$(choose_engine)" || die "no engine selected — use: thermaltune calibrate --mode adaptive --engine ttc|thermald"
    fi
    if [ "$MODE" = "adaptive" ]; then
        if [ "$ENGINE" != "thermald" ] && [ "$ENGINE" != "ttc" ]; then
            die "unknown engine: $ENGINE (use --engine thermald|ttc)"
        fi
        if [ "$ENGINE" = "ttc" ] && [ "$CAP_MODE" != "pct" ]; then
            die "the ttc engine needs intel_pstate in active mode (max_perf_pct) — not available on this driver"
        fi
        log "mode: adaptive (engine: $ENGINE)"
    fi

    local driver missing=() dep
    driver="$(cpu_driver)"
    log "driver: $driver (cap mode: $CAP_MODE)"
    for dep in stress-ng turbostat; do
        command -v "$dep" >/dev/null 2>&1 || missing+=("$dep")
    done
    if [ "$MODE" = "adaptive" ] && [ "$ENGINE" = "thermald" ]; then
        if ! command -v thermald >/dev/null 2>&1 && ! { command -v pacman >/dev/null 2>&1 && pacman -Q thermald >/dev/null 2>&1; }; then
            missing+=("thermald")
        fi
    fi
    if [ "$UI_TOOL" != "tty" ] && ! command -v zenity >/dev/null 2>&1 && ! command -v kdialog >/dev/null 2>&1; then
        missing+=("zenity")
    fi
    if [ "${#missing[@]}" -gt 0 ]; then
        if ui_ask "thermaltune — install dependencies" \
            "thermaltune needs these packages to calibrate:
  ${missing[*]}

Install them now with pacman (you will be asked for your password)?"; then
            sudo pacman -S --needed --noconfirm "${missing[@]}" || die "dependency installation failed"
        else
            die "dependencies missing: ${missing[*]}"
        fi
    fi

    # battery pre-check (skipped for defer: the run itself requires AC)
    local pstate batt
    pstate="$(power_state)"
    batt="$(battery_pct)"
    if [ "$DEFER" != "1" ] && [ "$pstate" = "battery" ]; then
        if [ "$batt" -ge 0 ] && [ "$batt" -lt 50 ]; then
            die "battery at ${batt}% — plug in AC before calibrating"
        fi
        if [ "$batt" -ge 0 ]; then
            warn "running on battery (${batt}%) — results may differ on AC; AC calibration is recommended"
        else
            warn "running on battery (level unknown) — results may differ on AC; AC calibration is recommended"
        fi
    fi

    [ -n "$TARGET_TEMP" ] || TARGET_TEMP="$(derive_target_temp)"

    # time estimate (typical assumes the sweep stops early; worst counts every step)
    local heavy list_text est est_worst nsteps ntyp
    if [ "$PROFILE" = "quick" ]; then nsteps=4; ntyp=5; else nsteps=12; ntyp=8; fi
    est="$(est_minutes "$ntyp")"
    est_worst="$(est_minutes_worst "$nsteps")"

    if [ "$DEFER" = "1" ]; then
        if [ "$MODE" != "cap" ]; then
            die "deferred calibration supports cap mode only — enable adaptive afterwards with: thermaltune mode adaptive"
        fi
        local dmsg="thermaltune DEFERRED calibration (profile: $PROFILE)

At your NEXT BOOT with AC power, thermaltune runs unattended:
  * ~${est} min of full all-core CPU load, starting shortly after boot
    (leave the machine alone while it runs)
  * no popups — progress: journalctl -u thermaltune-autocal -f
  * the found cap is applied and survives reboot/suspend
  * runs once, then removes itself (retries at the next AC boot if it fails)
Skipped checks: heavy apps (fresh boot), battery (AC required anyway).

Schedule this?"
        ui_ask "thermaltune" "$dmsg" || die "aborted by user"
        log "scheduling deferred calibration (one sudo password needed)..."
        local rc=0
        sudo -p "[thermaltune] password: " bash "$SELF" --_internal defer-calibration || rc=$?
        [ "$rc" = "0" ] || die "could not schedule the deferred calibration"
        ui_info "thermaltune — scheduled" "Deferred calibration is scheduled.

It runs automatically at your next boot with AC power (~${est} min of CPU load — leave the machine be).

Watch:    journalctl -u thermaltune-autocal -f
Cancel:   sudo systemctl disable thermaltune-autocal.service
Result:   thermaltune status"
        echo "deferred calibration scheduled — runs at next boot with AC power"
        return 0
    fi

    heavy="$(detect_heavy_apps)"
    list_text="none detected"
    [ -n "$heavy" ] && list_text="$heavy"

    local msg
    if [ "$MODE" = "cap" ]; then
        msg="thermaltune will calibrate your CPU's highest stable frequency cap.

What happens:
  * several full all-core load tests (your CPU will run hot, fans loud)
  * the best cap is applied and survives reboot/suspend
Typical duration: ~${est} min (at most ~${est_worst} min).
Target: peak temperature stays <= ${TARGET_TEMP} C.

Detected heavy apps — please close them first:
  $list_text

Start calibration now?"
    else
        msg="thermaltune will set up ADAPTIVE thermal management (engine: $ENGINE).

What happens:
  * a calibration of the temperature target: several full all-core
    load runs (your CPU will run hot, fans loud)
  * afterwards the engine stays active: full speed in bursts,
    automatically clamped as the CPU approaches ${TARGET_TEMP} C
Typical duration: ~${est} min (at most ~${est_worst} min).

Detected heavy apps — please close them first:
  $list_text

Start calibration now?"
    fi
    ui_ask "thermaltune" "$msg" || die "aborted by user"

    # ---- hand off to root phase ----
    printf 'PROFILE=%s\nTARGET_TEMP=%s\nMODE=%s\nENGINE=%s\n' "$PROFILE" "$TARGET_TEMP" "$MODE" "$ENGINE" > "$ANSWERS"
    chmod 600 "$ANSWERS"
    log "starting privileged phase (you may be asked for your sudo password)..."
    local rc=0
    # hold a sleep/idle inhibit lock so suspend cannot corrupt the run
    if command -v systemd-inhibit >/dev/null 2>&1; then
        sudo -p "[thermaltune] password: " systemd-inhibit --what="sleep:idle" bash "$SELF" --_internal calibrate "$ANSWERS" || rc=$?
    else
        sudo -p "[thermaltune] password: " bash "$SELF" --_internal calibrate "$ANSWERS" || rc=$?
    fi
    rm -f "$ANSWERS"
    if [ "$rc" != "0" ]; then
        die "calibration failed (exit $rc) — previous cap was restored"
    fi

    # ---- user phase: summary popup ----
    local res="$RUNS_ROOT/latest/result.env"
    [ -f "$res" ] || die "calibration finished but no result file found"
    local rpct rpeak rclock rops rdeg rmode rengine rtarget
    rpct="$(getkey "$res" RESULT_PCT)"
    rpeak="$(getkey "$res" RESULT_PEAK_C)"
    rclock="$(getkey "$res" RESULT_CLOCK_MHZ)"
    rops="$(getkey "$res" RESULT_OPS_S)"
    rdeg="$(getkey "$res" RESULT_DEGRADED)"
    rmode="$(getkey "$res" RESULT_MODE)"
    rengine="$(getkey "$res" RESULT_ENGINE)"
    rtarget="$(getkey "$res" RESULT_TARGET)"
    local summary
    if [ "$rmode" = "adaptive" ]; then
        summary="Adaptive mode is now active.

Engine: $rengine
Target: peak temperature <= ${rtarget:-?} C (measured peak: ${rpeak} C)
The controller survives reboot and suspend. Full details: $RUNS_ROOT/latest"
    else
        summary="Calibration complete.

Saved cap: ${rpct}% (~$(( ORIG_MAX_FREQ * rpct / 100 / 1000 )) MHz)
Sustained clock: ${rclock} MHz   Peak temp: ${rpeak} C
Throughput: ${rops} ops/s
Cap survives reboot and suspend. Full details: $RUNS_ROOT/latest"
        [ "$rdeg" = "1" ] && summary="$summary

NOTE: no fully stable point was found — the chosen cap is the best
available; your machine may be dust-limited. See doctor."
    fi
    ui_info "thermaltune — done" "$summary"
    echo "$summary"
}

cmd_internal_calibrate() { # $1 = answers file ; runs as root
    [ "$(id -u)" = 0 ] || die "internal phase must run as root"
    touch "$CAL_GUARD"
    local answers=$1
    [ -f "$answers" ] || die "answers file missing"
    while IFS='=' read -r k v; do
        case "$k" in
            PROFILE) PROFILE="$v" ;;
            TARGET_TEMP) TARGET_TEMP="$v" ;;
            MODE) MODE="$v" ;;
            ENGINE) ENGINE="$v" ;;
        esac
    done < "$answers"

    detect_platform
    PKG_TEMP_FILE="$(find_pkg_temp)" || die "no CPU temperature sensor"
    PKG_CRIT_FILE="$(find_pkg_crit || true)"
    RAPL_AVAILABLE=0; rapl_ok && RAPL_AVAILABLE=1

    if [ "$MODE" = "adaptive" ]; then
        cmd_internal_adaptive_calibrate
        return
    fi

    local run_dir="$RUNS_ROOT/$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$run_dir"

    # record + trap restore
    local orig_snapshot
    orig_snapshot="$(snapshot_cap)"
    restore_cap_fn() { printf '%s\n' "$orig_snapshot" | restore_cap; }
    trap 'restore_cap_fn; rm -f "$CAL_GUARD"; echo "[thermaltune] interrupted — previous cap restored" >&2; exit 130' INT TERM

    # idle sanity pre-check
    echo "[precheck] settling ${SETTLE_S}s before baseline ..."
    sleep "$SETTLE_S"
    local idle_now
    idle_now="$(pkg_temp_c)"
    local idle_limit
    idle_limit="$(awk -v t="$TARGET_TEMP" 'BEGIN{printf "%d", t-10}')"
    if awk -v t="$idle_now" -v c="$idle_limit" 'BEGIN{exit !(t+0 > c+0)}'; then
        die "idle package temp ${idle_now}C is above ${idle_limit}C with no load — your cooling is failing (dust, dead fan, bad mount). Clean it first; calibration would produce garbage."
    fi
    echo "[precheck] idle ${idle_now}C — OK (target ${TARGET_TEMP}C)"

    local candidates
    if [ "$PROFILE" = "quick" ]; then candidates="70 55 45"; else candidates="85 73 63 55 47"; fi
    local nsteps
    if [ "$PROFILE" = "quick" ]; then nsteps=4; else nsteps=12; fi
    echo "[plan] profile=$PROFILE load=${LOAD_S}s/step settle=${SETTLE_S}s candidates: $candidates"
    echo "[plan] duration: typically ~$(est_minutes 8) min, at most ~$(est_minutes_worst "$nsteps") min"

    # ---- baseline ----
    run_step "baseline-100" 100 "$run_dir"
    local base_env="$run_dir/baseline-100.env"
    if [ "$(getkey "$base_env" stable)" = "1" ]; then
        echo "[result] uncapped CPU already runs flat within target — no cap needed on this machine/workload"
        local bp=$(getkey "$base_env" peak_temp_c) bc=$(getkey "$base_env" steady_clock_mhz) bo=$(getkey "$base_env" ops_per_s) bpw=$(getkey "$base_env" power_w)
        write_conf cap 100 "$TARGET_TEMP" "$(power_state)" "$bp" "$bc" "$bo" "$TARGET_TEMP" ""
        disable_adaptive_engines
        printf 'RESULT_PCT=100\nRESULT_PEAK_C=%s\nRESULT_CLOCK_MHZ=%s\nRESULT_OPS_S=%s\nRESULT_POWER_W=%s\nRESULT_DEGRADED=0\nRESULT_BASELINE_STABLE=1\nRESULT_TARGET=%s\nRESULT_DATE=%s\nRESULT_POWER_STATE=%s\nRUN_DIR=%s\n' \
            "$bp" "$bc" "$bo" "$bpw" "$TARGET_TEMP" "$(date +%Y-%m-%dT%H:%M:%S)" "$(power_state)" "$run_dir" > "$run_dir/result.env"
        chmod 644 "$run_dir"/*.env "$run_dir"/*.csv "$run_dir"/*.tstat "$run_dir"/*.log 2>/dev/null
        ln -sfn "$run_dir" "$RUNS_ROOT/latest"
        trap - INT TERM
        rm -f "$CAL_GUARD"
        set_cap_pct 100
        echo "[done] nothing to apply — full speed is already stable"
        return 0
    fi

    # ---- sweep (descending; stop at first stable) ----
    local p cand="" last_unstable=100 r envf
    for p in $candidates; do
        run_step "sweep-$p" "$p" "$run_dir"
        envf="$run_dir/sweep-$p.env"
        if [ "$(getkey "$envf" stable)" = "1" ]; then cand="$p"; break; fi
        last_unstable="$p"
    done

    local degraded=0
    if [ -z "$cand" ]; then
        degraded=1
        cand="$p"
        warn "no stable point found across the whole sweep — using the lowest tested cap ($cand%)"
    else
        # ---- refinement between last_unstable and candidate ----
        local it=0 mid
        while [ $(( last_unstable - cand )) -ge 8 ] && [ "$it" -lt 2 ]; do
            mid=$(( (last_unstable + cand) / 2 ))
            run_step "refine-$mid" "$mid" "$run_dir"
            if [ "$(getkey "$run_dir/refine-$mid.env" stable)" = "1" ]; then
                cand="$mid"
            else
                last_unstable="$mid"
            fi
            it=$(( it + 1 ))
        done
        # ---- confirm: try pushing the cap UP while it stays flat ----
        local tries=0 hi
        while [ "$tries" -lt 2 ]; do
            hi=$(( cand + 7 )); [ "$hi" -gt 100 ] && hi=100
            [ "$hi" -eq "$cand" ] && break
            run_step "confirm-high-$hi" "$hi" "$run_dir"
            if [ "$(getkey "$run_dir/confirm-high-$hi.env" stable)" = "1" ]; then
                cand="$hi"; tries=$(( tries + 1 ))
            else
                break
            fi
        done
        # ---- final confirmation of the candidate ----
        local ok=0 attempt newcand="$cand"
        for attempt in 1 2; do
            run_step "confirm-final" "$newcand" "$run_dir"
            if [ "$(getkey "$run_dir/confirm-final.env" stable)" = "1" ]; then ok=1; break; fi
            newcand=$(( newcand - 7 )); [ "$newcand" -lt 30 ] && newcand=30
        done
        cand="$newcand"
        [ "$ok" = 1 ] || warn "final confirmation unstable — using last candidate with reduced confidence"
    fi

    # ---- apply + persist ----
    local fenv="$run_dir/confirm-final.env"
    [ -f "$fenv" ] || fenv="$run_dir/sweep-$cand.env"
    local fpeak fclock fops fpw
    fpeak="$(getkey "$fenv" peak_temp_c)"; fclock="$(getkey "$fenv" steady_clock_mhz)"
    fops="$(getkey "$fenv" ops_per_s)"; fpw="$(getkey "$fenv" power_w)"
    set_cap_pct "$cand"
    write_conf cap "$cand" "$TARGET_TEMP" "$(power_state)" "$fpeak" "$fclock" "$fops" "$TARGET_TEMP" ""
    disable_adaptive_engines
    do_install_persistence

    printf 'RESULT_PCT=%s\nRESULT_PEAK_C=%s\nRESULT_CLOCK_MHZ=%s\nRESULT_OPS_S=%s\nRESULT_POWER_W=%s\nRESULT_DEGRADED=%s\nRESULT_BASELINE_STABLE=0\nRESULT_TARGET=%s\nRESULT_DATE=%s\nRESULT_POWER_STATE=%s\nRUN_DIR=%s\n' \
        "$cand" "$fpeak" "$fclock" "$fops" "$fpw" "$degraded" "$TARGET_TEMP" "$(date +%Y-%m-%dT%H:%M:%S)" "$(power_state)" "$run_dir" > "$run_dir/result.env"
    chmod 644 "$run_dir"/*.env "$run_dir"/*.csv "$run_dir"/*.tstat "$run_dir"/*.log 2>/dev/null
    ln -sfn "$run_dir" "$RUNS_ROOT/latest"

    # ---- summary table ----
    {
        echo "thermaltune calibration summary — $(date)"
        echo "profile=$PROFILE target=${TARGET_TEMP}C power=$(power_state)"
        echo
        printf '%-18s %5s %8s %8s %9s %7s %7s %9s %8s\n' STEP PCT TEMP PEAK CLOCK DIPS RATIO PWR OPS/S
        for e in "$run_dir"/*.env; do
            [ "$(basename "$e")" = "result.env" ] && continue
            printf '%-18s %5s %8s %8s %9s %7s %7s %9s %8s\n' \
                "$(getkey "$e" label)" "$(getkey "$e" pct)" \
                "$(getkey "$e" steady_temp_c)" "$(getkey "$e" peak_temp_c)" \
                "$(getkey "$e" steady_clock_mhz)" "$(getkey "$e" dips_frac)" \
                "$(getkey "$e" clock_ratio_pct)" "$(getkey "$e" power_w)" \
                "$(getkey "$e" ops_per_s)"
        done
    } | tee "$run_dir/summary.txt"
    chmod 644 "$run_dir/summary.txt"

    trap - INT TERM
    rm -f "$CAL_GUARD"
    echo "[done] cap ${cand}% applied, saved and persisted"
}

# ------------------------------------------------------------- adaptive mode --

find_thermal_cdev() { # echo the best cooling device thermald can drive (root)
    # thermald has built-in rapl_controller support: usable whenever RAPL is
    # readable, even without a sysfs cooling device (our dev machine's case).
    if [ -n "${RAPL_AVAILABLE:-}" ] && [ "$RAPL_AVAILABLE" = "1" ]; then
        echo "rapl_controller"; return 0
    fi
    local d t
    for d in /sys/class/thermal/cooling_device*; do
        [ -e "$d" ] || continue
        t="$(cat "$d/type" 2>/dev/null)" || continue
        [ "$t" = "rapl_controller" ] && { echo "$t"; return 0; }
    done
    for d in /sys/class/thermal/cooling_device*; do
        [ -e "$d" ] || continue
        t="$(cat "$d/type" 2>/dev/null)" || continue
        case "$t" in Processor|processor) echo "$t"; return 0 ;; esac
    done
    for d in /sys/class/thermal/cooling_device*; do
        [ -e "$d" ] || continue
        t="$(cat "$d/type" 2>/dev/null)" || continue
        case "$t" in intel_powerclamp|TCC*) echo "$t"; return 0 ;; esac
    done
    return 1
}

write_thermald_conf() { # $1 = target C, $2 = cooling device type
    local tgt=$1 cdev=$2
    mkdir -p "$(dirname "$THERMALD_CONF")"
    cat > "$THERMALD_CONF" <<XML
<?xml version="1.0"?>
<!-- Generated by thermaltune adaptive mode (target ${tgt}C).
     Undo: thermaltune mode cap  (restores any previous config) -->
<ThermalConfiguration>
  <Platform>
    <Name>thermaltune adaptive</Name>
    <ProductName>*</ProductName>
    <Preference>QUIET</Preference>
    <ThermalZones>
      <ThermalZone>
        <Type>x86_pkg_temp</Type>
        <TripPoints>
          <TripPoint>
            <SensorType>x86_pkg_temp</SensorType>
            <Temperature>$(( tgt * 1000 ))</Temperature>
            <type>passive</type>
            <ControlType>SEQUENTIAL</ControlType>
            <CoolingDevice>
              <type>$cdev</type>
            </CoolingDevice>
          </TripPoint>
        </TripPoints>
      </ThermalZone>
    </ThermalZones>
XML
    # PID tuning only makes sense for the Processor (T-state) device; the
    # built-in rapl_controller has its own continuous control logic.
    if [ "$cdev" = "Processor" ]; then
        cat >> "$THERMALD_CONF" <<XML2
    <CoolingDevices>
      <CoolingDevice>
        <Type>Processor</Type>
        <PidControl>
          <kp>0.0002</kp>
          <kd>0</kd>
          <ki>0</ki>
        </PidControl>
      </CoolingDevice>
    </CoolingDevices>
XML2
    fi
    printf '  </Platform>\n</ThermalConfiguration>\n' >> "$THERMALD_CONF"
    chmod 644 "$THERMALD_CONF"
}

backup_thermald_conf() {
    [ -f "$THERMALD_CONF" ] || return 0
    [ -f "$THERMALD_CONF_BAK" ] && return 0
    cp -a "$THERMALD_CONF" "$THERMALD_CONF_BAK"
    log "backed up existing thermald config to $THERMALD_CONF_BAK"
}

disable_adaptive_engines() { # stop our controller, restore thermald pre-thermaltune state
    systemctl disable --now thermaltune-adaptive.service 2>/dev/null || true
    if [ -f "$THERMALD_CONF_BAK" ]; then
        cp -a "$THERMALD_CONF_BAK" "$THERMALD_CONF"
        rm -f "$THERMALD_CONF_BAK"
        log "thermald configuration restored"
    else
        rm -f "$THERMALD_CONF"
    fi
    rm -f "$THERMALD_DROPIN"
    systemctl daemon-reload 2>/dev/null || true
    systemctl try-restart thermald.service 2>/dev/null || true
}

cmd_internal_adaptive_calibrate() {
    [ "$(id -u)" = 0 ] || die "internal phase must run as root"
    local run_dir="$RUNS_ROOT/$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$run_dir"

    local orig_snapshot
    orig_snapshot="$(snapshot_cap)"
    restore_cap_fn() { printf '%s\n' "$orig_snapshot" | restore_cap; }
    trap 'restore_cap_fn; disable_adaptive_engines >/dev/null 2>&1; rm -f "$CAL_GUARD"; echo "[thermaltune] interrupted — previous cap restored, engines disabled" >&2; exit 130' INT TERM

    [ -n "$TARGET_TEMP" ] || TARGET_TEMP="$(derive_target_temp)"
    echo "[plan] adaptive calibration: engine=$ENGINE target=${TARGET_TEMP}C load=${LOAD_S}s/step"
    set_cap_pct 100

    local target="$TARGET_TEMP" cdev="" engaged=0 attempt peak

    if [ "$ENGINE" = "thermald" ]; then
        cdev="$(find_thermal_cdev || true)"
        if [ -z "$cdev" ]; then
            restore_cap_fn
            trap - INT TERM
            die "no cooling device thermald can drive — try: thermaltune calibrate --mode adaptive --engine ttc"
        fi
        echo "[thermald] control device: $cdev"
        backup_thermald_conf
        write_thermald_conf "$target" "$cdev"
        systemctl unmask thermald.service >/dev/null 2>&1 || true
        systemctl enable --now thermald.service >/dev/null 2>&1 || systemctl restart thermald.service 2>/dev/null || true
        sleep 3
        local jerr
        jerr="$(journalctl -u thermald.service -n 30 --no-pager 2>/dev/null | grep -iE 'error|fatal|cannot' | head -3)"
        [ -n "$jerr" ] && warn "thermald journal: $(echo "$jerr" | head -1)"
        for attempt in 1 2 3; do
            echo "[verify] run $attempt/3: full speed, thermald must clamp near ${target}C"
            run_step "adaptive-verify-$attempt" 100 "$run_dir"
            peak="$(getkey "$run_dir/adaptive-verify-$attempt.env" peak_temp_c)"
            if awk -v p="$peak" -v t="$target" 'BEGIN{exit !(p+0 <= t+3)}'; then
                engaged=1; break
            fi
            target=$(( target - 5 ))
            echo "[verify] peak ${peak}C — lowering target to ${target}C and retrying"
            write_thermald_conf "$target" "$cdev"
            systemctl restart thermald.service 2>/dev/null || true
        done
        if [ "$engaged" != "1" ]; then
            echo "[thermald] did not clamp within 3 verification runs — restoring previous state"
            restore_cap_fn
            disable_adaptive_engines
            trap - INT TERM
            die "thermald engine failed to engage on this machine — try: thermaltune calibrate --mode adaptive --engine ttc"
        fi
    else
        echo "[ttc] installing controller (target ${target}C) ..."
        write_conf adaptive 100 "$TARGET_TEMP" "$(power_state)" "" "" "" "$target" ttc
        do_install_persistence
        systemctl enable --now thermaltune-adaptive.service >/dev/null 2>&1 || true
        sleep 3
        systemctl is-active thermaltune-adaptive.service >/dev/null 2>&1 \
            || { restore_cap_fn; disable_adaptive_engines; trap - INT TERM; die "adaptive service failed to start (see: journalctl -u thermaltune-adaptive)"; }
        for attempt in 1 2 3; do
            echo "[verify] run $attempt/3: full speed, controller must clamp near ${target}C"
            run_step "adaptive-verify-$attempt" 100 "$run_dir"
            peak="$(getkey "$run_dir/adaptive-verify-$attempt.env" peak_temp_c)"
            if awk -v p="$peak" -v t="$target" 'BEGIN{exit !(p+0 <= t+3)}'; then
                engaged=1; break
            fi
            target=$(( target - 5 ))
            echo "[verify] peak ${peak}C — lowering target to ${target}C and retrying"
            set_conf_key ADAPT_TARGET "$target"
        done
        if [ "$engaged" != "1" ]; then
            echo "[ttc] did not clamp within 3 verification runs — rolling back"
            restore_cap_fn
            disable_adaptive_engines
            trap - INT TERM
            die "ttc engine failed to clamp on this machine — measurement data in $run_dir"
        fi
    fi

    # ---- persist final adaptive state ----
    local venv="$run_dir/adaptive-verify-$attempt.env"
    local fpeak fclock fops fpw
    fpeak="$(getkey "$venv" peak_temp_c)"; fclock="$(getkey "$venv" steady_clock_mhz)"
    fops="$(getkey "$venv" ops_per_s)"; fpw="$(getkey "$venv" power_w)"
    write_conf adaptive 100 "$TARGET_TEMP" "$(power_state)" "$fpeak" "$fclock" "$fops" "$target" "$ENGINE"
    do_install_persistence

    printf 'RESULT_MODE=adaptive\nRESULT_ENGINE=%s\nRESULT_PCT=100\nRESULT_TARGET=%s\nRESULT_PEAK_C=%s\nRESULT_CLOCK_MHZ=%s\nRESULT_OPS_S=%s\nRESULT_POWER_W=%s\nRESULT_ENGAGED=1\nRESULT_DEGRADED=0\nRESULT_DATE=%s\nRESULT_POWER_STATE=%s\nRUN_DIR=%s\n' \
        "$ENGINE" "$target" "$fpeak" "$fclock" "$fops" "$fpw" "$(date +%Y-%m-%dT%H:%M:%S)" "$(power_state)" "$run_dir" > "$run_dir/result.env"
    chmod 644 "$run_dir"/*.env "$run_dir"/*.csv "$run_dir"/*.tstat "$run_dir"/*.log 2>/dev/null
    ln -sfn "$run_dir" "$RUNS_ROOT/latest"

    {
        echo "thermaltune adaptive calibration summary — $(date)"
        echo "engine=$ENGINE target=${target}C power=$(power_state)"
        echo
        printf '%-22s %5s %8s %9s %8s\n' STEP PCT PEAK CLOCK OPS/S
        for e in "$run_dir"/adaptive-verify-*.env; do
            [ -e "$e" ] || continue
            printf '%-22s %5s %8s %9s %8s\n' \
                "$(getkey "$e" label)" "$(getkey "$e" pct)" \
                "$(getkey "$e" peak_temp_c)" "$(getkey "$e" steady_clock_mhz)" \
                "$(getkey "$e" ops_per_s)"
        done
    } | tee "$run_dir/summary.txt"
    chmod 644 "$run_dir/summary.txt"

    trap - INT TERM
    rm -f "$CAL_GUARD"
    echo "[done] adaptive mode active: engine=$ENGINE target=${target}C"
}

cmd_internal_adaptive_loop() { # ttc engine body — runs as a systemd service (root)
    [ "$(id -u)" = 0 ] || die "adaptive-loop must run as root"
    detect_platform
    PKG_TEMP_FILE="$(find_pkg_temp)" || die "no CPU temperature sensor found"
    PKG_CRIT_FILE="$(find_pkg_crit || true)"
    echo "[ttc] thermaltune adaptive controller active (poll 2s)"
    local last_change=0 t target pct step gap
    while :; do
        if [ "$(getkey "$CONF" MODE 2>/dev/null)" != "adaptive" ]; then
            sleep 5; continue
        fi
        target="$(getkey "$CONF" ADAPT_TARGET 2>/dev/null)"
        case "${target:-}" in ''|*[!0-9]*) target=85 ;; esac
        t="$(pkg_temp_c)"
        if awk -v t="$t" -v T="$target" 'BEGIN{exit !(t+0 >= T+0)}'; then
            # proportional cut: the further above target, the bigger and faster.
            # (a fixed -5%/12s ratchet cannot catch a cold-start burst: the first
            # real check measured a 95C peak because 8 steps took ~96 seconds)
            if   awk -v t="$t" -v T="$target" 'BEGIN{exit !(t+0 >= T+8)}'; then step=-15; gap=4
            elif awk -v t="$t" -v T="$target" 'BEGIN{exit !(t+0 >= T+3)}'; then step=-10; gap=6
            else step=-5; gap=12; fi
            if [ "$SECONDS" -ge $(( last_change + gap )) ]; then
                pct="$(get_cap_pct)"
                case "$pct" in ''|*[!0-9]*) pct=100 ;; esac
                if [ "$pct" -gt 35 ]; then
                    pct=$(( pct + step )); [ "$pct" -lt 35 ] && pct=35
                    set_cap_pct "$pct"; last_change=$SECONDS
                    echo "[ttc] hot ${t}C (target ${target}C) -> cap ${pct}%"
                fi
            fi
        elif awk -v t="$t" -v T="$target" 'BEGIN{exit !(t+0 <= T-6)}'; then
            if [ "$SECONDS" -ge $(( last_change + 12 )) ]; then
                pct="$(get_cap_pct)"
                case "$pct" in ''|*[!0-9]*) pct=100 ;; esac
                if [ "$pct" -lt 100 ]; then
                    pct=$(( pct + 2 )); [ "$pct" -gt 100 ] && pct=100
                    set_cap_pct "$pct"; last_change=$SECONDS
                    echo "[ttc] cool ${t}C (target $(( target - 6 ))C) -> cap ${pct}%"
                fi
            fi
        fi
        sleep 2
    done
}

# ---------------------------------------------------------------- selftest ---

cmd_selftest() {
    local dir="${1:-}"
    if [ -z "$dir" ]; then
        dir="$(dirname "$SELF")/tests/data"
        [ -d "$dir" ] || dir="/tmp/opencode/thermal"
    fi
    [ -d "$dir" ] || die "selftest data dir not found: $dir (recorded data from the machine thermaltune was developed on)"
    # label -> cap MHz mapping for the recorded runs
    # (cap1.0GHz.. = manual harness runs; sweep-*/baseline-100 = real
    #  thermaltune root runs with RAPL, recorded 2026-11-14)
    declare -A CAPMAP=( [uncapped]=3600 [cap2.8GHz]=2800 [cap2.4GHz]=2400 [cap1.0GHz]=1000 [cap2.2GHz]=2200 [cap2.0GHz]=2000 \
                        [baseline-100]=3600 [sweep-47]=1692 [sweep-55]=1980 [sweep-63]=2268 [sweep-73]=2628 [sweep-85]=3060 )
    declare -A EXPECT=( [uncapped]=0 [cap2.8GHz]=0 [cap2.4GHz]=0 [cap1.0GHz]=1 [cap2.2GHz]=0 [cap2.0GHz]=1 \
                        [baseline-100]=0 [sweep-47]=1 [sweep-55]=1 [sweep-63]=0 [sweep-73]=0 [sweep-85]=0 )
    local pass=0 fail=0 f label cap out got exp
    echo "thermaltune selftest — validating analyzer against recorded calibration data in $dir"
    for f in "$dir"/*.csv; do
        [ -e "$f" ] || continue
        label="$(basename "$f" .csv)"
        [ -n "${CAPMAP[$label]+x}" ] || { echo "  [skip] $label (no cap mapping)"; continue; }
        cap="${CAPMAP[$label]}"; exp="${EXPECT[$label]}"
        out="$(analyze_csv "$f" "$cap" 85)"
        got="$(echo "$out" | sed -n 's/^STABLE=\([0-9]\).*/\1/p')"
        if [ "$got" = "$exp" ]; then
            echo "  [pass] $label: stable=$got (expected $exp) — $(echo "$out" | sed -n 's/^/         /p' | tr '\n' ' ')"
            pass=$(( pass + 1 ))
        else
            echo "  [FAIL] $label: stable=$got (expected $exp) — $out"
            fail=$(( fail + 1 ))
        fi
    done
    echo "selftest: $pass passed, $fail failed"
    [ "$fail" -eq 0 ]
}

# -------------------------------------------------------------------- main ---

usage() {
    sed -n '2,46p' "$SELF" | sed 's/^# \{0,1\}//'
    echo
    echo "full help is in the header of $SELF and in README.md"
}

main() {
    # global flags
    while [ $# -gt 0 ]; do
        case "$1" in
            --profile) [ $# -ge 2 ] || die "option $1 needs a value (see --help)"; PROFILE="$2"; shift 2 ;;
            --target-temp) [ $# -ge 2 ] || die "option $1 needs a value (see --help)"; TARGET_TEMP="$2"; shift 2 ;;
            --load-seconds) [ $# -ge 2 ] || die "option $1 needs a value (see --help)"; LOAD_S="$2"; shift 2 ;;
            --mode) [ $# -ge 2 ] || die "option $1 needs a value (see --help)"; MODE="$2"; shift 2 ;;
            --engine) [ $# -ge 2 ] || die "option $1 needs a value (see --help)"; ENGINE="$2"; shift 2 ;;
            --defer) DEFER="1"; shift ;;
            -h|--help) usage; exit 0 ;;
            --version|version) echo "thermaltune $VERSION"; exit 0 ;;
            *) break ;;
        esac
    done
    [ $# -gt 0 ] || { usage; exit 0; }

    PKG_TEMP_FILE="$(find_pkg_temp 2>/dev/null || true)"
    PKG_CRIT_FILE="$(find_pkg_crit 2>/dev/null || true)"
    if [ -e /sys/devices/system/cpu/intel_pstate/max_perf_pct ]; then CAP_MODE=pct; fi
    ORIG_MAX_FREQ="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 2>/dev/null || echo 0)"

    case "$1" in
        calibrate) shift; cmd_calibrate "$@" ;;
        check) shift; cmd_check "$@" ;;
        status) cmd_status ;;
        doctor) cmd_doctor ;;
        apply|on) cmd_apply ;;
        off) cmd_off ;;
        mode) shift; cmd_mode "$@" ;;
        uninstall) cmd_uninstall ;;
        install-persistence) cmd_install_persistence ;;
        --selftest) shift; cmd_selftest "$@" ;;
        --_internal)
            shift
            case "${1:-}" in
                calibrate) shift; cmd_internal_calibrate "$@" ;;
                defer-calibration) cmd_internal_defer_calibration ;;
                adaptive-loop) cmd_internal_adaptive_loop ;;
                *) die "unknown internal command" ;;
            esac
            ;;
        *) die "unknown command: $1 (see --help)" ;;
    esac
}

main "$@"
